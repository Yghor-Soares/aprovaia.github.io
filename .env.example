PORT=3000
CORS_ALLOWED_ORIGINS=https://yghor-soares.github.io
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
ENABLE_GEMINI_FALLBACK=false
ENABLE_PAID_OPENAI_FALLBACK=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Web app config from Firebase Project settings. These values are public client identifiers.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=

# Firebase Admin credentials. Keep the service-account JSON outside this project.
# Download it from Firebase Console > Project settings > Service accounts.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\outside\the\project\firebase-service-account.json
